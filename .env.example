POSTGRES_DB=cyberhub
POSTGRES_USER=cyberhub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://cyberhub:change-me-local-only@localhost:5432/cyberhub?schema=public
API_PORT=4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_COOKIE_NAME=cyberhub_session
SESSION_TTL_DAYS=7
NODE_ENV=development
